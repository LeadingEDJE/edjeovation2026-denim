API_PORT=4000
DATABASE_URL=postgres://denim:denim@localhost:5432/denim_fit
THIRD_PARTY_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:4000
# Optional: enables Claude re-ranking in the recommendation engine.
# Leave unset to use the deterministic rule-based fallback.
ANTHROPIC_API_KEY=
# Optional: point the Anthropic SDK at a compatible proxy (e.g. a LiteLLM
# gateway). Leave unset for the default api.anthropic.com.
ANTHROPIC_BASE_URL=
# Optional: model the recommender uses. Default claude-opus-4-8 (native API).
# For a LiteLLM gateway use a model it serves, e.g. claude-opus-4.7.
RECOMMENDER_MODEL=
