{
	"name": "edjeovation2026-denim",
	"private": true,
	"version": "0.1.0",
	"workspaces": [
		"packages/*",
		"apps/api",
		"apps/web",
		"apps/scraper"
	],
	"scripts": {
		"dev": "npm run dev -w @denim-fit/api & npm run dev -w @denim-fit/web",
		"dev:api": "npm run dev -w @denim-fit/api",
		"dev:web": "npm run dev -w @denim-fit/web",
		"db:migrate": "npm run db:migrate -w @denim-fit/api",
		"build": "npm run build --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"test:e2e:smoke": "playwright test --grep @readonly",
		"test:e2e:mutating": "playwright test --grep @mutating",
		"e2e:install": "playwright install --with-deps chromium",
		"prepare": "husky"
	},
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@playwright/test": "1.61.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@testing-library/user-event": "^14.5.2",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.9",
		"husky": "^9.1.7",
		"jsdom": "^25.0.1",
		"vitest": "^4.1.9"
	}
}
